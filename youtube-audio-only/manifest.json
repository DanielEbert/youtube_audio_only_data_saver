{
  "manifest_version": 2,
  "name": "YouTube Audio Only (Data Saver)",
  "version": "1.3.2",
  "description": "Stream audio only on YouTube to save mobile data and battery.",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-audio-only-20211419@local",
      "strict_min_version": "79.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "*://*.youtube.com/*"
  ],
  "web_accessible_resources": [
    "inject.js"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_action": {
    "default_title": "YouTube Audio Only",
    "default_popup": "popup.html"
  }
}
